{
    "name": "routegroup/laravel-imoje",
    "description": "Package for imoje payments",
    "keywords": [
        "routegroup",
        "laravel",
        "imoje"
    ],
    "homepage": "https://github.com/routegroup/laravel-imoje",
    "license": "MIT",
    "authors": [
        {
            "name": "Kajetan Nobel",
            "email": "k.nobel@routegroup.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.15.3||^8.0.2",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "justinrainbow/json-schema": "^6.10.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30.5",
        "nunomaduro/collision": "^8.9.5",
        "larastan/larastan": "^3.10",
        "orchestra/testbench": "^11.2.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.7.8",
        "pestphp/pest-plugin-arch": "^4.0.2",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Routegroup\\Imoje\\Payment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Routegroup\\Imoje\\Payment\\Tests\\": "tests/"
        }
    },
     "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse src --memory-limit=1G",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Routegroup\\Imoje\\Payment\\ImojeServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
